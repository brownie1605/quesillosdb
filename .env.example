# ============================================================
# QUESILLOS LO NUESTRO - POS Hibrido (Local + Nube)
# Copia este archivo como .env y completa los valores.
# ============================================================

FLASK_APP=run.py
# "development" activa el debugger interactivo de Werkzeug -- solo para tu
# maquina de desarrollo. En la maquina real del negocio SIEMPRE debe ser
# "production": con debug activo y expuesto en la red (HOST=0.0.0.0), el
# debugger permite ejecutar codigo arbitrario a cualquiera en la misma WiFi.
FLASK_ENV=production
# Genera una propia con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# ---------- Base de datos LOCAL (MySQL en la maquina del negocio) ----------
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=
DB_LOCAL_NAME=quesillos_local

# ---------- Base de datos REMOTA (Railway / nube) ----------
DB_REMOTE_HOST=
DB_REMOTE_PORT=3306
DB_REMOTE_USER=root
DB_REMOTE_PASSWORD=
DB_REMOTE_NAME=pos_inventario_cloud

# ---------- Sincronizacion ----------
SYNC_ENABLED=true
SYNC_INTERVAL=120
NETWORK_CHECK_INTERVAL=30
SYNC_TIMEOUT=30
SYNC_BATCH_SIZE=200

# ---------- Respaldos automaticos (corren aunque SYNC_ENABLED=false) ----------
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENCION_DIAS=14

ID_EMPRESA=1
ID_SUCURSAL=1
DEVICE_ID=local-01
# Los registros creados localmente usan IDs desde este numero en adelante,
# para no colisionar con los que genera la nube (1..999999).
LOCAL_ID_OFFSET=1000000

# ---------- Correo (recuperacion de contrasena) ----------
# SMTP_PASS = "Contrasena de aplicacion" de Google (16 caracteres, sin espacios)
# Generarla en: https://myaccount.google.com/apppasswords  (requiere 2FA activo)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quesilloslonuestro26@gmail.com
SMTP_PASS=
PASSWORD_RECOVERY_TIMEOUT=900
