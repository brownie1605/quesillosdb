# ============================================================
# QUESILLOS LO NUESTRO - POS Hibrido (Local + Nube)
# Copia este archivo como .env y completa los valores.
# ============================================================

FLASK_APP=run.py
# "development" activa el debugger interactivo de Werkzeug -- solo para tu
# maquina de desarrollo. En la maquina real del negocio SIEMPRE debe ser
# "production": con debug activo y expuesto en la red (HOST=0.0.0.0), el
# debugger permite ejecutar codigo arbitrario a cualquiera en la misma WiFi.
FLASK_ENV=production
# Genera una propia con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# ---------- Base de datos LOCAL (MySQL en la maquina del negocio) ----------
# Desarrollo con Docker (README 2.4b): DB_LOCAL_HOST=127.0.0.1,
# DB_LOCAL_PORT=3307, DB_LOCAL_PASSWORD=quesillos y SYNC_ENABLED=false
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=
DB_LOCAL_NAME=quesillos_local

# ---------- Base de datos REMOTA (Railway / nube) ----------
DB_REMOTE_HOST=
DB_REMOTE_PORT=3306
DB_REMOTE_USER=root
DB_REMOTE_PASSWORD=
DB_REMOTE_NAME=pos_inventario_cloud

# ---------- Sincronizacion ----------
SYNC_ENABLED=true
SYNC_INTERVAL=120
NETWORK_CHECK_INTERVAL=30
SYNC_TIMEOUT=30
SYNC_BATCH_SIZE=200

# ---------- Respaldos automaticos (corren aunque SYNC_ENABLED=false) ----------
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENCION_DIAS=14

# ---------- Cloudflare R2 (copia del respaldo fuera del disco local) ----------
# Opcional: si se deja vacio, el respaldo solo se queda en disco local
# (bd/respaldos/). En Railway el disco es efimero -- se pierde en cada
# redeploy -- asi que en produccion esto deberia estar configurado.
# R2_ACCOUNT_ID: el ID de cuenta de Cloudflare (dashboard R2 -> API).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: de un R2 API Token con permiso
#   de lectura/escritura sobre el bucket.
# R2_BUCKET_NAME: nombre del bucket ya creado en R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

ID_EMPRESA=1
ID_SUCURSAL=1
# Nombre unico de este equipo (la nube: "nube"; el restaurante: "restaurante-01").
DEVICE_ID=local-01

# ---------- Papel de este equipo ----------
# "local": PC del restaurante (base propia, sigue vendiendo sin internet).
# "nube":  la instancia de Railway (no se sincroniza consigo misma).
MODO_NODO=local
# Numeracion de IDs: cada equipo genera IDs con su propia terminacion para
# que nunca se repitan. 1 = nube, 2 = restaurante, 3 en adelante = otros.
ID_NODO=2
ID_INCREMENTO=10
ID_NODO_NUBE=1
# Dias que la nube guarda su registro de cambios (sync_queue).
RETENCION_COLA_DIAS=90
# Rango fijo anterior; ya no es lo que evita choques de IDs (ver README 2.4a).
LOCAL_ID_OFFSET=1000000

# ---------- Correo (recuperacion de contrasena) ----------
# SMTP_PASS = "Contrasena de aplicacion" de Google (16 caracteres, sin espacios)
# Generarla en: https://myaccount.google.com/apppasswords  (requiere 2FA activo)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quesilloslonuestro26@gmail.com
SMTP_PASS=
PASSWORD_RECOVERY_TIMEOUT=900
