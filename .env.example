# ============================================================
# QUESILLOS LO NUESTRO - POS Hibrido (Local + Nube)
# Copia este archivo como .env y completa los valores.
# ============================================================

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# ---------- Base de datos LOCAL (MySQL en la maquina del negocio) ----------
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=
DB_LOCAL_NAME=quesillos_local

# ---------- Base de datos REMOTA (Railway / nube) ----------
DB_REMOTE_HOST=
DB_REMOTE_PORT=3306
DB_REMOTE_USER=root
DB_REMOTE_PASSWORD=
DB_REMOTE_NAME=pos_inventario_cloud

# ---------- Sincronizacion ----------
SYNC_ENABLED=true
SYNC_INTERVAL=120
NETWORK_CHECK_INTERVAL=30
SYNC_TIMEOUT=30
SYNC_BATCH_SIZE=200

ID_EMPRESA=1
ID_SUCURSAL=1
DEVICE_ID=local-01

# ---------- Correo (recuperacion de contrasena) ----------
# SMTP_PASS = "Contrasena de aplicacion" de Google (16 caracteres, sin espacios)
# Generarla en: https://myaccount.google.com/apppasswords  (requiere 2FA activo)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quesilloslonuestro26@gmail.com
SMTP_PASS=
PASSWORD_RECOVERY_TIMEOUT=900
